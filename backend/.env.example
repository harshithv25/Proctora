# Proctora Backend — Environment Configuration
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="file:./dev.db"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_MIN_32_CHAR_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AES-256-GCM — 32 bytes expressed as 64 hex chars
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_KEY

# CSRF — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET

# TOTP
TOTP_ISSUER=Proctora-NITK

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173
